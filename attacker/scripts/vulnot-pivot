        "flag": "VULNOT{purdue_conduit_pivot_paths_mapped}",
    }
    print(json.dumps(topology, indent=2))
    return 0


def cmd_lotl_relay(args: argparse.Namespace) -> int:
    win_cmd = (
        f"netsh interface portproxy add v4tov4 listenaddress=0.0.0.0 "
        f"listenport={args.listen_port} connectaddress={args.target_ip} connectport={args.target_port}"
    )
    linux_cmd = (
        f"nohup socat TCP4-LISTEN:{args.listen_port},fork,reuseaddr "
        f"TCP4:{args.target_ip}:{args.target_port} >/dev/null 2>&1 &"
    )
    out = {
        "tool": "vulnot-pivot",
        "module": "lotl-relay",
        "action": args.action,
        "Windows_JumpHost_Command": win_cmd,
        "Linux_EdgeGateway_Command": linux_cmd,
        "mitre_technique": "T1090.001 - Internal Proxy (Living-off-the-Land)",
        "relay_status": "ACTIVE" if args.action == "create" else "FLUSHED",
        "flag": "VULNOT{volt_typhoon_netsh_portproxy_chain_found}",
    }
    print(json.dumps(out, indent=2))
    return 0


