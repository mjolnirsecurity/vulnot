def cmd_replay_mitm(args: argparse.Namespace) -> int:
    replay_bundle = {
        "tool": "vulnot-fuzz",
        "module": "replay-mitm",
        "scenario": args.scenario,
        "target": args.target,
        "captured_baseline_samples": 60,
        "hmi_spoofed_telemetry": {
            "reported_status": "NOMINAL",
            "spoofed_values": {
                "water": {"pH": 7.2, "chlorine_ppm": 1.8},
                "factory": {"vfd_frequency_hz": 50.0, "motor_rpm": 1500},
                "reactor": {"core_temp_c": 85.0, "cooling_valve": "OPEN"},
                "frostygoop": {"reported_supply_temp_c": 84.5, "calibration_offset_c": 65.0},
            }.get(args.scenario, {"status": "NOMINAL"}),
        },
        "physical_sabotage_injection": {
            "water": "HR4_chlorine_ppm=150 (15.0 ppm toxic overdose)",
            "factory": "DB1_vfd_freq_hz=1410 -> 2 -> 1064 Hz centrifuge resonant sweep",
            "reactor": "CoolingOn=False while suppressing high-temp alarm",
            "frostygoop": "HR0_main_steam_valve=0% (actual supply drops to 18.0 C)",
        }.get(args.scenario, "Custom register drift injected"),
        "mitre_ics": ["T0856 - Spoof Reporting Message", "T0831 - Manipulation of Control"],
        "flag": "VULNOT{stuxnet_hmi_telemetry_replay_synthesized}",
    }
    print(json.dumps(replay_bundle, indent=2))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="VULNOT Multi-Protocol ICS & AI Grammar Fuzzer")
    sub = p.add_subparsers(dest="command", required=True)

    s_mb = sub.add_parser("fuzz-modbus", help="Fuzz Modbus TCP MBAP headers, broadcast unit IDs & UMAS FC90")
    s_mb.add_argument("--target", default="10.0.1.10")
    s_mb.add_argument("--port", type=int, default=502)
    s_mb.add_argument("--iterations", type=int, default=50)
    s_mb.set_defaults(func=cmd_fuzz_modbus)

    s_dnp = sub.add_parser("fuzz-dnp3", help="Fuzz DNP3 frames, CROB pulse floods & CVE-2015-5374 relay DoS")
    s_dnp.add_argument("--target", default="10.0.2.10")
    s_dnp.add_argument("--port", type=int, default=20000)
    s_dnp.set_defaults(func=cmd_fuzz_dnp3)

    s_s7 = sub.add_parser("fuzz-s7", help="Fuzz S7comm COTP TPDU, PI services (0x29 STOP) & Safety DB writes")
    s_s7.add_argument("--target", default="10.0.3.10")
    s_s7.add_argument("--port", type=int, default=102)
    s_s7.set_defaults(func=cmd_fuzz_s7)

    s_mcp = sub.add_parser("fuzz-mcp", help="Fuzz AI SCADA Copilot MCP JSON-RPC schemas & prompt delimiters")
    s_mcp.add_argument("--target", default="10.0.90.10:8090")
    s_mcp.set_defaults(func=cmd_fuzz_mcp)

    s_rep = sub.add_parser("replay-mitm", help="Synthesize Stuxnet/FrostyGoop HMI telemetry replay payload")
    s_rep.add_argument("--scenario", choices=["water", "factory", "reactor", "frostygoop"], default="factory")
    s_rep.add_argument("--target", default="10.0.3.10")
    s_rep.set_defaults(func=cmd_replay_mitm)

    return p


if __name__ == "__main__":
    parser = build_parser()
    ns = parser.parse_args()
    sys.exit(ns.func(ns))
