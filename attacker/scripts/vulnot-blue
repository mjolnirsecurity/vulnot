#!/usr/bin/env python3
"""
VULNOT Unified Blue Team SOC Console, Threat Hunter & Safe Containment CLI
==========================================================================
Blue Team & SOC Defender toolkit complementing `vulnot-forensics`:
1. `soc-triage`: Unified SOC posture across OT IDS rules (28 rules), SIEM correlation
   rules (26 rules), IEC 62443 compliance domains, and active Physics CBF interlocks.
2. `hunt`: Executes hypothesis-driven MITRE ATT&CK for ICS & MITRE ATLAS threat hunts
   across Historian telemetry, DMZ conduits, PLC blocks, and AI inference pipelines.
3. `pcap-analyze`: Deep-packet industrial protocol analyzer extracting unauthorized
   writes, calibration spoofs, and prompt-injection payloads from PCAPs/streams.
4. `contain`: Executes OT-Safe Incident Containment with pre-flight physical safety
   checks so Blue Teamers isolate threats without tripping critical plant processes.
5. `export-rules`: Exports VULNOT detections as portable Sigma, Suricata, and YARA rules.
"""

import argparse
import json
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]


def cmd_soc_triage(args: argparse.Namespace) -> int:
    ids_mod = SourceFileLoader("ot_ids", str(REPO_ROOT / "defense/ids/ot_ids.py")).load_module()
    siem_mod = SourceFileLoader("siem_rules", str(REPO_ROOT / "defense/siem/rules/correlation_rules.py")).load_module()
    iec_mod = SourceFileLoader("iec62443", str(REPO_ROOT / "defense/compliance/iec62443.py")).load_module()

    ids_engine = ids_mod.OTIDSEngine()
    siem_engine = siem_mod.CorrelationEngine()
    iec_assessment = iec_mod.ComplianceAssessment()
    iec_summary = iec_assessment.get_compliance_summary()

    protocols_covered = sorted({r.protocol for r in ids_engine.rules})
    report = {
        "tool": "vulnot-blue",
        "module": "soc-triage",
        "timestamp": time.time(),
        "ot_ids": {
            "total_rules": len(ids_engine.rules),
            "critical_rules": sum(1 for r in ids_engine.rules if r.severity.value == "CRITICAL"),
            "protocols_covered": protocols_covered,
            "ai_ot_rules": [r.id for r in ids_engine.rules if r.id.startswith(("AI-", "FROSTY-", "DER-", "DECEPTION-"))],
        },
        "siem_correlation": {
            "total_correlation_rules": len(siem_engine.rules),
            "sequence_kill_chain_rules": [
                r.id for r in siem_engine.rules.values() if r.rule_type.value == "sequence"
            ],
            "v401_rules": [r_id for r_id in siem_engine.rules if int(r_id.split("-")[1]) >= 21],
        },
        "iec62443_posture": {
            "framework": iec_summary["framework"],
            "target_security_level": iec_summary["target_security_level"],
            "total_requirements": iec_summary["total_requirements"],
            "foundational_families": list(iec_summary["families"].keys()),
        },
        "flag": "VULNOT{blue_team_soc_triage_unified_posture}",
    }
    print(json.dumps(report, indent=2))
    return 0


