def cmd_cryo_sabotage(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("cryo_coldchain", str(REPO_ROOT / "simulators/cryo-coldchain/main.py")).load_module()
    sim = mod.CryoColdChainSimulator()
    if getattr(args, "status_only", False):
        print(json.dumps(sim.state.to_dict(), indent=2))
        return 0
    sp = getattr(args, "setpoint", 110.0)
    fd = getattr(args, "force_defrost", True)
    sa = getattr(args, "suppress_alarm", True)
    live = _try_live_http(
        5021, "/sabotage", {"setpoint": sp, "force_defrost": fd, "suppress_alarm": sa}
    )
    res = sim.execute_coldchain_sabotage(
        new_setpoint_c=sp,
        force_defrost_heater=fd,
        suppress_local_alarm=sa,
    )
    if live:
        res["live_socket_sync"] = "http://127.0.0.1:5021/sabotage"
    print(json.dumps(res, indent=2))
    return 0


