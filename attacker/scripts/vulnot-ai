    bms = getattr(args, "disable_bms", True)
    evp = getattr(args, "ev_pulse_mw", 15.0)
    live = _try_live_http(8093, "/oscillate", {"invert_droop": inv, "disable_bms": bms, "ev_pulse_mw": evp})
    res = sim.execute_oscillation_attack(
        invert_freq_watt_droop=inv,
        disable_bms_interlock=bms,
        ocpp_megawatt_pulse_mw=evp,
    )
    if live:
        res["live_socket_sync"] = "http://127.0.0.1:8093/oscillate"
    if bms:
        res["bms_flag"] = "VULNOT{bess_bms_thermal_interlock_overridden}"
    print(json.dumps(res, indent=2))
    return 0


