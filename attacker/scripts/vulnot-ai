#!/usr/bin/env python3
"""
vulnot-ai — VULNOT AI-in-OT & Emerging ICS Threat Exploitation / Defense CLI
Supports Labs 12-15, Forensics 06-07, and SOC 05.
"""

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
for p in (REPO_ROOT, REPO_ROOT / "simulators"):
    if str(p) not in sys.path:
        sys.path.insert(0, str(p))


def cmd_copilot_status(_args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_copilot", str(REPO_ROOT / "simulators/ai-scada-copilot/main.py")).load_module()
    sim = mod.AISCadaCopilotSimulator()
    state = sim.state.to_dict()
    state["discovery_flag"] = "VULNOT{ot_copilot_mcp_tools_enumerated}"
    print(json.dumps(state, indent=2))
    return 0


def cmd_inject_prompt(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_copilot", str(REPO_ROOT / "simulators/ai-scada-copilot/main.py")).load_module()
    sim = mod.AISCadaCopilotSimulator()
    res = sim.evaluate_note_for_injection(args.source, args.payload)
    if res.get("injected"):
        res["verification_flag"] = "VULNOT{llm_masked_scada_summary_verified}"
    print(json.dumps(res, indent=2))
    return 0


def cmd_pdm_probe(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_pdm", str(REPO_ROOT / "simulators/ai-pdm-engine/main.py")).load_module()
    sim = mod.AIPdMVisionSimulator()
    res = sim.evaluate_telemetry_sample(args.vibration, args.temp, args.flow)
    res["manifold_flag"] = "VULNOT{pdm_autoencoder_manifold_mapped}"
    print(json.dumps(res, indent=2))
    return 0


def cmd_pdm_evade(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_pdm", str(REPO_ROOT / "simulators/ai-pdm-engine/main.py")).load_module()
    sim = mod.AIPdMVisionSimulator()
    res = sim.evaluate_telemetry_sample(args.vibration, args.temp, args.flow, args.harmony)
    print(json.dumps(res, indent=2))
    return 0


def cmd_vision_backdoor(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_pdm", str(REPO_ROOT / "simulators/ai-pdm-engine/main.py")).load_module()
    sim = mod.AIPdMVisionSimulator()
    res = sim.deploy_vision_model(args.model, backdoor_trigger=True)
    print(json.dumps(res, indent=2))
    return 0


def cmd_rl_spoof(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_rl", str(REPO_ROOT / "simulators/ai-rl-optimizer/main.py")).load_module()
    sim = mod.AIRLSoarSimulator()
    res = sim.evaluate_rl_step(args.outside_temp, args.occupancy, args.price_spike)
    if res.get("thermal_runaway_triggered"):
        res["rl_flag"] = "VULNOT{rl_chiller_reward_hack_thermal_runaway}"
    print(json.dumps(res, indent=2))
    return 0


def cmd_soar_dos(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("ai_rl", str(REPO_ROOT / "simulators/ai-rl-optimizer/main.py")).load_module()
    sim = mod.AIRLSoarSimulator()
    res = sim.trigger_soar_alert(args.spoof_ip, args.signature)
    print(json.dumps(res, indent=2))
    return 0


def cmd_bess_oscillate(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("der_microgrid", str(REPO_ROOT / "simulators/der-microgrid/main.py")).load_module()
    sim = mod.DERMicrogridSimulator()
    res = sim.execute_oscillation_attack(
        invert_freq_watt_droop=args.invert_droop,
        disable_bms_interlock=args.disable_bms,
        ocpp_megawatt_pulse_mw=args.ev_pulse_mw,
    )
    if args.disable_bms:
        res["bms_flag"] = "VULNOT{bess_bms_thermal_interlock_overridden}"
    print(json.dumps(res, indent=2))
    return 0


def cmd_frostygoop(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("district_heating", str(REPO_ROOT / "simulators/district-heating/main.py")).load_module()
    sim = mod.DistrictHeatingSimulator()
    res = sim.apply_frostygoop_attack(args.setpoint, args.valve, args.offset)
    res["fc16_flag"] = "VULNOT{frostygoop_enco_modbus_fc16_identified}"
    print(json.dumps(res, indent=2))
    return 0


def cmd_cryo_sabotage(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("cryo_coldchain", str(REPO_ROOT / "simulators/cryo-coldchain/main.py")).load_module()
    sim = mod.CryoColdChainSimulator()
    if args.status_only:
        print(json.dumps(sim.state.to_dict(), indent=2))
        return 0
    res = sim.execute_coldchain_sabotage(
        new_setpoint_c=args.setpoint,
        force_defrost_heater=args.force_defrost,
        suppress_local_alarm=args.suppress_alarm,
    )
    print(json.dumps(res, indent=2))
    return 0


def cmd_cryo_rescue(args: argparse.Namespace) -> int:
    from importlib.machinery import SourceFileLoader
    mod = SourceFileLoader("cryo_coldchain", str(REPO_ROOT / "simulators/cryo-coldchain/main.py")).load_module()
    sim = mod.CryoColdChainSimulator()
    res = sim.execute_oncall_rescue(
        isolate_contractor_vpn=args.isolate_contractor_vpn,
        enable_cbf_cutout=args.enable_cbf_cutout,
    )
    print(json.dumps(res, indent=2))
    return 0


